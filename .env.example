# Copy to .env and fill in values. Never commit .env.
# When OPENAI_API_KEY is empty, the backend uses the local Ollama endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5

# Azure Speech resource configuration
AZURE_SPEECH_KEY=
AZURE_SPEECH_TTS_REGION=southeastasia

# Optional path to an installed TTF/OTF font with Myanmar and Thai glyphs.
VIDEO_FONT_PATH=
